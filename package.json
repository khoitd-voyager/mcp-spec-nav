{
  "name": "mcp-spec-nav",
  "version": "0.5.1",
  "description": "MCP server that catalogs the functions across a polyglot monorepo and reads code structurally — find existing functions to reuse (by words, what they call, or behavioural similarity), read them in full, find callers in TS/JS (type-checked) and 13 other languages (evidence-based), survey every match for a pattern with the function it sits in, and trace HTTP/RPC/event flows between services statically (Express, Fastify, NestJS, FastAPI, Flask, fetch, axios, requests, httpx, kafkajs)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-spec-nav": "dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-navigation",
    "ast",
    "tree-sitter",
    "ts-morph",
    "claude",
    "typescript",
    "javascript",
    "python",
    "go",
    "java",
    "ruby",
    "rust",
    "php",
    "csharp",
    "kotlin",
    "swift",
    "vue",
    "svelte",
    "polyglot"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "bench": "npm run build && node bench/run.mjs",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "ts-morph": "^24.0.0",
    "web-tree-sitter": "^0.27.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
