# The grammars declare the native `tree-sitter` binding as an optional peer, and
# they disagree about its version (0.21 vs 0.22). We never load the native
# binding — grammars are read as .wasm through web-tree-sitter — so the conflict
# is over a package that is not installed. Without this, `npm i` and `npx` fail
# on ERESOLVE for a dependency nothing uses.
legacy-peer-deps=true

# Note: do NOT add `omit=optional` here. It would skip the node-gyp-build step
# the grammars use to compile that unused native binding, but it also drops
# esbuild's platform binary (@esbuild/darwin-arm64 and friends), which is an
# optionalDependency — and the build then fails. The gyp step is allowed to run
# and is harmless if it fails, since nothing requires its output.
